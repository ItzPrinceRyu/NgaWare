--============================================================
-- Helpers
--============================================================
local function getHRP()
    local char = localPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getBackpackCount()
    local bp = localPlayer:FindFirstChild("Backpack")
    if not bp then return 0 end
    local n = 0
    for _, v in ipairs(bp:GetChildren()) do
        if v:IsA("Tool") then n = n + 1 end
    end
    return n
end

--============================================================
-- Core Logic
--============================================================
local function sellAll()
    if selling then return end
    local hrp = getHRP()
    local sellSpot = workspace:FindFirstChild("SellSpot")
    if not hrp or not sellSpot then return end

    selling = true
    local savedCFrame = hrp.CFrame
    hrp.CFrame = sellSpot.CFrame
    task.wait(0.4)

    local prompt = sellSpot:FindFirstChild("SellAllPrompt")
        or sellSpot:FindFirstChild("SellPrompt")
        or sellSpot:FindFirstChildWhichIsA("ProximityPrompt", true)

    if prompt then
        pcall(function() fireproximityprompt(prompt) end)
    end

    task.wait(0.4)
    local newHRP = getHRP()
    if newHRP then newHRP.CFrame = savedCFrame end
    selling = false
end

task.spawn(function()
    while task.wait(1) do
        if autoSellTimed then
            task.wait(timerSeconds)
            if autoSellTimed then sellAll() end
        end
        if autoSellFull and not selling and getBackpackCount() >= 50 then sellAll() end
        if autoSellLimit and not selling and getBackpackCount() >= sellLimit then sellAll() end
    end
end)

local function shouldCollect(model)
    if collectAll then return true end
    if startCollecting and table.find(selectFruits, model.Name) then return true end
    if startCollecting2 then
        for _, rar in ipairs(selectRarities) do
            if string.find(model.Name, rar, 1, true) then return true end
        end
    end
    return false
end

task.spawn(function()
    while task.wait(0.5) do
        if selling then continue end
        if not (startCollecting or startCollecting2 or collectAll) then continue end
        if not ProximityPromptService.Enabled then continue end

        for _, model in ipairs(workspace:GetChildren()) do
            if selling then break end
            if not (startCollecting or startCollecting2 or collectAll) then break end

            if model:IsA("Model") and model:FindFirstChild("Handle") then
                local handle = model.Handle
                local prompt = handle:FindFirstChild("PickUp")
                if not prompt or not prompt:IsA("ProximityPrompt") then continue end
                if not prompt.Enabled then continue end
                if not shouldCollect(model) then continue end

                local hrp = getHRP()
                if not hrp then continue end

                local origDist = prompt.MaxActivationDistance
                pcall(function() prompt.MaxActivationDistance = 32 end)

                hrp.CFrame = handle.CFrame
                task.wait(0.15)

                pcall(function() fireproximityprompt(prompt) end)

                local startT = tick()
                local picked = false
                while tick() - startT < 1.2 do
                    if not model.Parent then picked = true break end
                    local bp = localPlayer:FindFirstChild("Backpack")
                    if bp then
                        for _, item in ipairs(bp:GetChildren()) do
                            if item:IsA("Tool") and item.Name == model.Name then
                                picked = true
                                break
                            end
                        end
                    end
                    if picked then break end
                    task.wait(0.1)
                end

                pcall(function() prompt.MaxActivationDistance = origDist end)

                if not picked then
                    warn("[FruitForager] Failed to pick up:", model.Name)
                    task.wait(0.2)
                else
                    task.wait(0.1)
                end
            end
        end
    end
end)

RunService.Stepped:Connect(function()
    local char = localPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    if playerModsEnabled then
        humanoid.WalkSpeed = walkSpeed
        humanoid.UseJumpPower = true
        humanoid.JumpPower = jumpPower
        humanoid.HipHeight = floatHeight
        if noclip then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    else
        humanoid.HipHeight = 2
    end
end)

--============================================================
-- Watcher Logic
--============================================================
local function isTargetUsername(name)
    if name == localPlayer.Name then return false end
    local lower = name:lower()
    for _, target in ipairs(watchUsernames) do
        if target:lower() == lower then return true end
    end
    return false
end

local function serverHop()
    local placeId = game.PlaceId
    local jobId = game.JobId
    local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"

    local ok, response = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)

    if not ok or not response or not response.data then return end

    for _, server in ipairs(response.data) do
        if server.playing < server.maxPlayers and server.id ~= jobId then
            pcall(function() TeleportService:TeleportToPlaceInstance(placeId, server.id, localPlayer) end)
            return
        end
    end
end

local function checkAndHop()
    if not watcherEnabled then return end
    if #watchUsernames == 0 then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if isTargetUsername(player.Name) then
            serverHop()
            return
        end
    end
end

