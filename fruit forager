Tabs.Watcher:AddSection("Username Watch List")

local SaveStringInput
local AddUsernameInput

SaveStringInput = Tabs.Watcher:AddInput("SavedList", {
    Title = "Saved List",
    Default = "",
    Visible = false,
    Callback = function(val)
        if val and val ~= "" then
            watchUsernames = {}
            for name in string.gmatch(val, "([^,]+)") do
                table.insert(watchUsernames, name)
            end
        end
    end
})

local listLabel = Tabs.Watcher:AddParagraph({
    Title = "Current Watched Usernames",
    Content = "No usernames added yet.\n",
})

local function updateUIAndSave()
    if #watchUsernames == 0 then
        listLabel:SetDesc("No usernames added yet.\n")
    else
        local text = ""
        for i, name in ipairs(watchUsernames) do
            text = text .. i .. ". " .. name .. "\n"
        end
        listLabel:SetDesc(text)
    end

    local saveStr = table.concat(watchUsernames, ",")
    if SaveStringInput then
        SaveStringInput:SetValue(saveStr)
    end
end

AddUsernameInput = Tabs.Watcher:AddInput("NewUsername", {
    Title = "Add Username",
    Placeholder = "Type username and press Enter",
    Finished = true,
    Callback = function(value)
        value = value:gsub("%s+", "")
        if value == "" then return end
        for _, existing in ipairs(watchUsernames) do
            if existing:lower() == value:lower() then 
                AddUsernameInput:SetValue("")
                return 
            end
        end
        table.insert(watchUsernames, value)
        updateUIAndSave()
        AddUsernameInput:SetValue("")
    end,
})

Tabs.Watcher:AddInput("RemoveUsername", {
    Title = "Remove Username",
    Placeholder = "Type exact username to remove",
    Finished = true,
    Callback = function(value)
        value = value:gsub("%s+", "")
        if value == "" then return end
        for i, existing in ipairs(watchUsernames) do
            if existing:lower() == value:lower() then
                table.remove(watchUsernames, i)
                break
            end
        end
        updateUIAndSave()
    end,
})

Tabs.Watcher:AddButton({
    Title = "Delete All Usernames",
    Callback = function()
        watchUsernames = {}
        updateUIAndSave()
        if SaveStringInput then SaveStringInput:SetValue("") end
        if AddUsernameInput then AddUsernameInput:SetValue("") end
    end,
})

